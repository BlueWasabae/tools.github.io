//@version=5
indicator("BlueX SMC Genesis Institutional Engine [XAU/USD]", 
          shorttitle="BlueX SMC Genesis", 
          overlay=true, 
          max_bars_back=500, 
          max_boxes_count=500, 
          max_lines_count=500, 
          max_labels_count=500)

// ==============================================================================
// 1. ARCHITECTURAL INPUTS & TIMEFRAME CONFIGURATION
// ==============================================================================
string G_MODE     = "Operational Hierarchy & Timeframe Architecture"
string i_mode     = input.string("Day Trade (M15 / M3)", "Trading Hierarchy", 
                     options=["Day Trade (M15 / M3)", "Swing Trade (H4 / H1 / M15)"], group=G_MODE)
int    i_pivotLen = input.int(5, "Swing Pivot Strength (V-Shape Wing Length)", minval=2, maxval=20, group=G_MODE,
                     tooltip="Number of bars required to confirm symmetrical V-shape pivot extremes.")

string G_VIS      = "Visual Form Model & Nomenclature"
string i_labelMode= input.string("Institutional (EST / MTF / LTF / FT)", "Label Notation Model",
                     options=["Institutional (EST / MTF / LTF / FT)", "Structural (BOS / iBOS / FT)"], group=G_VIS)
bool   i_showEST  = input.bool(true, "Show External Structure Range (EST.H / EST.L)", group=G_VIS)
bool   i_showInt  = input.bool(true, "Show Internal Structure Breaks (MTF / LTF)", group=G_VIS)
bool   i_showFT   = input.bool(true, "Show Failure to Traverse (FT - M15+ Only)", group=G_VIS,
                     tooltip="FT tracks micro internal breaks within an impulse move. Strictly deactivated on M3.")
bool   i_showSD   = input.bool(true, "Show Supply & Demand Zones (Zone Candle Model)", group=G_VIS)
bool   i_showStem = input.bool(true, "Show EST Origin Vertical Connector Stem", group=G_VIS)
bool   i_showHUD  = input.bool(true, "Show Telemetry HUD Dashboard", group=G_VIS)
int    i_maxZones = input.int(10, "Maximum Active S&D Zones", minval=2, maxval=25, group=G_VIS)

string G_ALERT    = "Execution Bridge & Webhook Gateway"
string i_secret   = input.string("BLUEX_QUANT_SECURE_TOKEN_9981", "Webhook Secret Bearer Token", group=G_ALERT)
float  i_riskPct  = input.float(1.0, "Account Risk %", minval=0.1, maxval=3.0, step=0.1, group=G_ALERT)

string G_THEME    = "Institutional Color Palette"
color  c_est      = input.color(#ef5350, "EST Range Bounds (Coral Red)", group=G_THEME)
color  c_labelTxt = input.color(#fbbf24, "Label Font Color (Gold/Yellow)", group=G_THEME)
color  c_pillBg   = input.color(color.new(#18181b, 20), "Internal Label Pill Background", group=G_THEME)
color  c_intLine  = input.color(#94a3b8, "Internal Break Line Color (Slate)", group=G_THEME)
color  c_ftLine   = input.color(#d97706, "FT Line Color (Amber)", group=G_THEME)
color  c_demand   = input.color(#10b981, "Demand Zone (Emerald)", group=G_THEME)
color  c_supply   = input.color(#ef4444, "Supply Zone (Rose)", group=G_THEME)
color  c_dimmed   = input.color(#64748b, "Mitigated Zone Color", group=G_THEME)

// ==============================================================================
// 2. TIMEFRAME CLASSIFICATION & FT FILTER RULE
// ==============================================================================
bool isM3  = timeframe.isminutes and timeframe.multiplier == 3
bool isM15 = timeframe.isminutes and timeframe.multiplier == 15

// Mechanical Rule: FT strictly prohibited on M3; active on M15 and higher
bool canDrawFT = not isM3 and i_showFT

// Structural Nomenclature mapping based on timeframe
string internalTag = isM3 ? "LTF" : isM15 ? "MTF" : "INT"
if i_labelMode == "Structural (BOS / iBOS / FT)"
    internalTag := "iBOS"

string majorTag = i_labelMode == "Institutional (EST / MTF / LTF / FT)" ? "EST" : "BOS"
string ftTag    = "FT"

string currentTfStr = timeframe.isminutes ? str.tostring(timeframe.multiplier) + "M" : timeframe.isdaily ? "D" : timeframe.period

// ==============================================================================
// 3. USER DEFINED TYPES (UDTs)
// ==============================================================================
type ZoneData
    box    bBox
    label  bLbl
    float  topPrice
    float  botPrice
    bool   isDemand
    bool   isActive
    int    startBar

var ZoneData[] activeZones = array.new<ZoneData>(0)

// ==============================================================================
// 4. V-SHAPE PIVOT DETECTION (NON-REPAINTING)
// ==============================================================================
float rawPivotHigh = ta.pivothigh(high, i_pivotLen, i_pivotLen)
float rawPivotLow  = ta.pivotlow(low, i_pivotLen, i_pivotLen)

// Active swing pivot levels waiting to be broken
var float activeHigh    = na
var int   activeHighBar = na
var float activeLow     = na
var int   activeLowBar  = na

// External Structure (Dealing Range extremes: EST.H & EST.L)
var float estHigh       = na
var int   estHighBar    = na
var float estLow        = na
var int   estLowBar     = na
var int   estOriginBar  = na

// Persistent lines for the active External Structure dealing range
var line estHighLine = na
var line estLowLine  = na
var line estStemLine = na
var label estHighLbl = na
var label estLowLbl  = na

// Structural State Machine:
// 0 = Seeking EST/BOS
// 1 = Seeking Internal Break (MTF/LTF/iBOS)
// 2 = Seeking Micro Break (FT on M15+)
var int structStage  = 0
var int currentTrend = 0 // 1 = Bullish, -1 = Bearish
var int lastBreakBar = 0

// Capture confirmed V-shape pivots
if not na(rawPivotHigh)
    int pBar = bar_index - i_pivotLen
    activeHigh    := rawPivotHigh
    activeHighBar := pBar
    if na(estHigh) or rawPivotHigh > estHigh
        estHigh    := rawPivotHigh
        estHighBar := pBar

if not na(rawPivotLow)
    int pBar = bar_index - i_pivotLen
    activeLow    := rawPivotLow
    activeLowBar := pBar
    if na(estLow) or rawPivotLow < estLow
        estLow    := rawPivotLow
        estLowBar := pBar

// ==============================================================================
// 5. MECHANICAL STRUCTURE BREAK ENGINE (EST, MTF, LTF, FT)
// ==============================================================================
bool isConfirmed = barstate.isconfirmed

bool isBullBreak = false
bool isBearBreak = false
string breakEvent = ""
string displayLabel = ""

var float activeZoneTop = na
var float activeZoneBot = na

if isConfirmed
    // --------------------------------------------------------------------------
    // BULLISH BREAK: Full Candle-Body Close Above Active Swing High
    // --------------------------------------------------------------------------
    if not na(activeHigh) and not na(activeHighBar) and close > activeHigh
        isBullBreak := true

        // Classify Structural Rank: External (EST) vs Internal (MTF/LTF) vs Micro (FT)
        bool isExternalBreak = (not na(estHigh) and activeHigh >= estHigh) or activeHighBar < lastBreakBar or currentTrend <= 0 or structStage == 0

        if isExternalBreak
            breakEvent   := "EST"
            displayLabel := majorTag
            structStage  := 1
            currentTrend := 1
            lastBreakBar := bar_index

            // Update External Structure Dealing Range (EST.H & EST.L)
            estHigh      := activeHigh
            estHighBar   := activeHighBar
            if not na(activeLow)
                estLow       := activeLow
                estLowBar    := activeLowBar
                estOriginBar := activeLowBar
        else if structStage == 1
            breakEvent   := internalTag
            displayLabel := internalTag
            structStage  := canDrawFT ? 2 : 1
            lastBreakBar := bar_index
        else if structStage == 2 and canDrawFT
            breakEvent   := "FT"
            displayLabel := ftTag
            structStage  := 1
            lastBreakBar := bar_index
        else
            breakEvent   := internalTag
            displayLabel := internalTag
            structStage  := 1
            lastBreakBar := bar_index

        // Visual Line & Dark Pill Drawing
        bool drawInternal = (breakEvent == internalTag and i_showInt) or (breakEvent == "FT" and canDrawFT)

        if drawInternal
            color lColor = breakEvent == "FT" ? c_ftLine : c_intLine
            line.new(x1=activeHighBar, y1=activeHigh, x2=bar_index, y2=activeHigh, color=lColor, style=line.style_dotted, width=1)
            label.new(x=int(math.round((activeHighBar + bar_index) / 2)), y=activeHigh, text=displayLabel, style=label.style_label_center, color=c_pillBg, textcolor=c_labelTxt, size=size.tiny)

        // ----------------------------------------------------------------------
        // ZONE CANDLE MODEL: DEMAND ZONE CREATION
        // Origin base candle is located at activeLowBar
        // ----------------------------------------------------------------------
        if i_showSD and not na(activeLowBar) and activeLowBar < bar_index
            int originOffset = math.min(math.max(0, bar_index - activeLowBar), 499)
            float dBot = low[originOffset]
            float dTop = math.max(open[originOffset], close[originOffset])

            if dTop <= dBot
                dTop := dBot + (ta.atr(14) * 0.3)

            activeZoneTop := dTop
            activeZoneBot := dBot

            box demandBox = box.new(left=activeLowBar, top=dTop, right=bar_index + 20, bottom=dBot, bgcolor=color.new(c_demand, 85), border_color=color.new(c_demand, 25), border_width=1, border_style=line.style_solid)
            label demandLbl = label.new(x=bar_index + 10, y=dTop, text="DEMAND [" + displayLabel + "] " + currentTfStr, style=label.style_label_left, color=color.new(c_demand, 10), textcolor=color.white, size=size.tiny)

            if array.size(activeZones) >= i_maxZones
                ZoneData oldZ = array.shift(activeZones)
                box.delete(oldZ.bBox)
                label.delete(oldZ.bLbl)

            array.push(activeZones, ZoneData.new(demandBox, demandLbl, dTop, dBot, true, true, activeLowBar))

        activeHigh := na // Invalidate broken pivot

    // --------------------------------------------------------------------------
    // BEARISH BREAK: Full Candle-Body Close Below Active Swing Low
    // --------------------------------------------------------------------------
    else if not na(activeLow) and not na(activeLowBar) and close < activeLow
        isBearBreak := true

        bool isExternalBreak = (not na(estLow) and activeLow <= estLow) or activeLowBar < lastBreakBar or currentTrend >= 0 or structStage == 0

        if isExternalBreak
            breakEvent   := "EST"
            displayLabel := majorTag
            structStage  := 1
            currentTrend := -1
            lastBreakBar := bar_index

            // Update External Structure Dealing Range (EST.H & EST.L)
            estLow       := activeLow
            estLowBar    := activeLowBar
            if not na(activeHigh)
                estHigh      := activeHigh
                estHighBar   := activeHighBar
                estOriginBar := activeHighBar
        else if structStage == 1
            breakEvent   := internalTag
            displayLabel := internalTag
            structStage  := canDrawFT ? 2 : 1
            lastBreakBar := bar_index
        else if structStage == 2 and canDrawFT
            breakEvent   := "FT"
            displayLabel := ftTag
            structStage  := 1
            lastBreakBar := bar_index
        else
            breakEvent   := internalTag
            displayLabel := internalTag
            structStage  := 1
            lastBreakBar := bar_index

        // Visual Line & Dark Pill Drawing
        bool drawInternal = (breakEvent == internalTag and i_showInt) or (breakEvent == "FT" and canDrawFT)

        if drawInternal
            color lColor = breakEvent == "FT" ? c_ftLine : c_intLine
            line.new(x1=activeLowBar, y1=activeLow, x2=bar_index, y2=activeLow, color=lColor, style=line.style_dotted, width=1)
            label.new(x=int(math.round((activeLowBar + bar_index) / 2)), y=activeLow, text=displayLabel, style=label.style_label_center, color=c_pillBg, textcolor=c_labelTxt, size=size.tiny)

        // ----------------------------------------------------------------------
        // ZONE CANDLE MODEL: SUPPLY ZONE CREATION
        // Origin base candle is located at activeHighBar
        // ----------------------------------------------------------------------
        if i_showSD and not na(activeHighBar) and activeHighBar < bar_index
            int originOffset = math.min(math.max(0, bar_index - activeHighBar), 499)
            float sTop = high[originOffset]
            float sBot = math.min(open[originOffset], close[originOffset])

            if sTop <= sBot
                sBot := sTop - (ta.atr(14) * 0.3)

            activeZoneTop := sTop
            activeZoneBot := sBot

            box supplyBox = box.new(left=activeHighBar, top=sTop, right=bar_index + 20, bottom=sBot, bgcolor=color.new(c_supply, 85), border_color=color.new(c_supply, 25), border_width=1, border_style=line.style_solid)
            label supplyLbl = label.new(x=bar_index + 10, y=sBot, text="SUPPLY [" + displayLabel + "] " + currentTfStr, style=label.style_label_left, color=color.new(c_supply, 10), textcolor=color.white, size=size.tiny)

            if array.size(activeZones) >= i_maxZones
                ZoneData oldZ = array.shift(activeZones)
                box.delete(oldZ.bBox)
                label.delete(oldZ.bLbl)

            array.push(activeZones, ZoneData.new(supplyBox, supplyLbl, sTop, sBot, false, true, activeHighBar))

        activeLow := na // Invalidate broken pivot

// ==============================================================================
// 6. EXTERNAL STRUCTURE BRACKET & STEM (EST.H / EST.L)
// ==============================================================================
if i_showEST and barstate.islast
    line.delete(estHighLine)
    line.delete(estLowLine)
    line.delete(estStemLine)
    label.delete(estHighLbl)
    label.delete(estLowLbl)

    if not na(estHigh) and not na(estHighBar)
        int startH = math.max(0, estHighBar)
        estHighLine := line.new(x1=startH, y1=estHigh, x2=bar_index + 20, y2=estHigh, color=c_est, style=line.style_solid, width=1)
        estHighLbl  := label.new(x=bar_index + 20, y=estHigh, text="EST.H", style=label.style_label_left, color=color.new(#000000, 100), textcolor=c_labelTxt, size=size.tiny)

    if not na(estLow) and not na(estLowBar)
        int startL = math.max(0, estLowBar)
        estLowLine := line.new(x1=startL, y1=estLow, x2=bar_index + 20, y2=estLow, color=c_est, style=line.style_solid, width=1)
        estLowLbl  := label.new(x=bar_index + 20, y=estLow, text="EST.L", style=label.style_label_left, color=color.new(#000000, 100), textcolor=c_labelTxt, size=size.tiny)

    // Vertical origin connector stem
    if i_showStem and not na(estOriginBar) and not na(estHigh) and not na(estLow)
        int stemX = math.max(0, estOriginBar)
        estStemLine := line.new(x1=stemX, y1=estLow, x2=stemX, y2=estHigh, color=c_est, style=line.style_solid, width=1)

// ==============================================================================
// 7. ZONE INVALIDATION & EXTENSION ENGINE
// ==============================================================================
if isConfirmed and array.size(activeZones) > 0
    for i = 0 to array.size(activeZones) - 1
        ZoneData z = array.get(activeZones, i)
        if z.isActive
            bool invalidated = false
            if z.isDemand and close < z.botPrice
                invalidated := true
            else if not z.isDemand and close > z.topPrice
                invalidated := true

            if invalidated
                z.isActive := false
                box.set_bgcolor(z.bBox, color.new(c_dimmed, 85))
                box.set_border_color(z.bBox, color.new(#64748b, 40))
                box.set_border_style(z.bBox, line.style_dotted)
                box.set_right(z.bBox, bar_index)
                label.set_color(z.bLbl, color.new(#334155, 30))
                label.set_textcolor(z.bLbl, #94a3b8)
                label.set_text(z.bLbl, (z.isDemand ? "MITIGATED DEMAND " : "MITIGATED SUPPLY ") + currentTfStr)
            else
                box.set_right(z.bBox, bar_index + 15)
                label.set_x(z.bLbl, bar_index + 15)

// ==============================================================================
// 8. TELEMETRY HUD TABLE
// ==============================================================================
var table hudTable = table.new(position.top_right, 2, 7, bgcolor=color.new(#030712, 15), border_color=color.new(#ffffff, 85), border_width=1)

if i_showHUD and barstate.islast
    table.cell(hudTable, 0, 0, "BlueX SMC Genesis", bgcolor=color.new(#090e1a, 0), text_color=#f59e0b, text_size=size.small)
    table.cell(hudTable, 1, 0, "Telemetry Engine", bgcolor=color.new(#090e1a, 0), text_color=#94a3b8, text_size=size.small)

    table.cell(hudTable, 0, 1, "Operational Mode", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hudTable, 1, 1, i_mode, text_color=#38bdf8, text_size=size.tiny)

    table.cell(hudTable, 0, 2, "Market Bias", text_color=#94a3b8, text_size=size.tiny)
    biasStr   = currentTrend == 1 ? "BULLISH" : currentTrend == -1 ? "BEARISH" : "NEUTRAL"
    biasColor = currentTrend == 1 ? #10b981 : currentTrend == -1 ? #ef4444 : #94a3b8
    table.cell(hudTable, 1, 2, biasStr, text_color=biasColor, text_size=size.tiny)

    table.cell(hudTable, 0, 3, "External Range High", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hudTable, 1, 3, not na(estHigh) ? str.tostring(estHigh, "#.##") : "Searching...", text_color=#f43f5e, text_size=size.tiny)

    table.cell(hudTable, 0, 4, "External Range Low", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hudTable, 1, 4, not na(estLow) ? str.tostring(estLow, "#.##") : "Searching...", text_color=#10b981, text_size=size.tiny)

    table.cell(hudTable, 0, 5, "Internal Notation", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hudTable, 1, 5, internalTag, text_color=#fbbf24, text_size=size.tiny)

    table.cell(hudTable, 0, 6, "FT Engine State", text_color=#94a3b8, text_size=size.tiny)
    ftStatus = isM3 ? "DEACTIVATED (M3 Rule)" : (i_showFT ? "ACTIVE (M15+)" : "DISABLED")
    table.cell(hudTable, 1, 6, ftStatus, text_color=isM3 ? #f59e0b : #10b981, text_size=size.tiny)

// ==============================================================================
// 9. WEBHOOK & QUANTITATIVE ALERTS DISPATCH
// ==============================================================================
if isConfirmed and (isBullBreak or isBearBreak)
    string dirStr   = isBullBreak ? "BUY_LIMIT" : "SELL_LIMIT"
    float  entryLvl = isBullBreak ? (not na(activeZoneTop) ? activeZoneTop : close) : (not na(activeZoneBot) ? activeZoneBot : close)
    float  slLvl    = isBullBreak ? (not na(activeZoneBot) ? activeZoneBot - 1.0 : entryLvl - (ta.atr(14) * 1.5)) : (not na(activeZoneTop) ? activeZoneTop + 1.0 : entryLvl + (ta.atr(14) * 1.5))
    float  risk     = math.abs(entryLvl - slLvl)
    float  tp1Lvl   = isBullBreak ? entryLvl + (risk * 3.0) : entryLvl - (risk * 3.0)

    string jsonMsg  = '{"secret":"' + i_secret + '","symbol":"XAUUSD","action":"' + dirStr + '","entry":' + str.tostring(entryLvl, "#.##") + ',"sl":' + str.tostring(slLvl, "#.##") + ',"tp1":' + str.tostring(tp1Lvl, "#.##") + ',"risk_pct":' + str.tostring(i_riskPct, "#.#") + ',"comment":"BlueX ' + displayLabel + ' (' + currentTfStr + ')"}'
    alert(jsonMsg, alert.freq_once_per_bar_close)

alertcondition(isBullBreak and breakEvent == "EST", title="Bullish External Structure Break (EST)", message="BlueX Bullish EST Confirmed on Close")
alertcondition(isBearBreak and breakEvent == "EST", title="Bearish External Structure Break (EST)", message="BlueX Bearish EST Confirmed on Close")
alertcondition(isBullBreak and breakEvent == internalTag, title="Bullish Internal Structure Break (MTF/LTF)", message="BlueX Bullish Internal Break Confirmed")
alertcondition(isBearBreak and breakEvent == internalTag, title="Bearish Internal Structure Break (MTF/LTF)", message="BlueX Bearish Internal Break Confirmed")
alertcondition(isBullBreak and breakEvent == "FT",  title="Bullish Failure to Traverse (FT)", message="BlueX Bullish FT Confirmed")
alertcondition(isBearBreak and breakEvent == "FT",  title="Bearish Failure to Traverse (FT)", message="BlueX Bearish FT Confirmed")
